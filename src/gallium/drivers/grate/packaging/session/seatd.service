[Unit]
Description=Seat management daemon
Documentation=man:seatd(1)
Before=phosh.service

[Service]
Type=simple
# -g video: sam is in video, and without a group the socket is root-only, so
# the compositor cannot take a seat and phoc dies inside libseat.
ExecStart=/usr/bin/seatd -g video
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
